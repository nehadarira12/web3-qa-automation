# Copy this file to `.env` and fill in a FRESH, disposable test wallet.
# Never put a real wallet's seed phrase or a mainnet-funded key in here —
# this suite loads these values into an automated browser.

# 12/24-word seed phrase for a wallet created solely for test automation.
METAMASK_SEED_PHRASE=your-test-wallet-seed-phrase

# Password used to unlock the MetaMask extension in the automated browser.
METAMASK_PASSWORD=your-test-password

# dApp under test. Defaults to MetaMask's own test dApp, which is built
# specifically for exercising wallet-integration flows like these.
TEST_DAPP_URL=https://metamask.github.io/test-dapp/

# Network the suite is allowed to run against. Sepolia only — see
# constants/networks.ts, which hardcodes Sepolia as TARGET_NETWORK
# regardless of this value; it is read for logging/reporting context.
NETWORK=sepolia
